 "sentences": [
  {
   "slot": "S1",
   "text": "There's a disturbing reason the eyes of this holy man leave everyone feeling judged.",
   "kind": "HOOK",
   "source": null,
   "show": [
    {
     "on": "eyes",
     "to": "eyes"
    },
    {
     "on": "man",
     "to": "pope_top"
    },
    {
     "on": "judged",
     "to": "pope_face"
    }
   ]
  },
  {
   "slot": "S2",
   "text": "This is Portrait of Innocent X, painted by Diego Velázquez in 1650.",
   "kind": "FACT",
   "source": 15
  },
  {
   "slot": "S3",
   "text": "The pope sits on a golden throne, a paper in one hand.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "pope",
     "to": "pope"
    },
    {
     "on": "throne",
     "to": "throne"
    },
    {
     "on": "paper",
     "to": "paper"
    }
   ]
  },
  {
   "slot": "S4",
   "text": "But look at his eyes.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "eyes",
     "to": "eyes"
    }
   ]
  },
  {
   "slot": "S5",
   "text": "His eyes turn sideways, toward you.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "eyes",
     "to": "eyes"
    },
    {
     "on": "you",
     "to": "pope_face"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "The pope doesn't smile.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "smile",
     "to": "pope_face"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "The pope doesn't bless.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "bless",
     "to": "hand_ring"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "The pope simply measures.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "measures",
     "to": "eyes"
    }
   ]
  },
  {
   "slot": "S7",
   "text": "According to the art dealer René Gimpel, the face was a whirlpool of life and the eyes were searching.",
   "kind": "FACT",
   "source": 30,
   "show": [
    {
     "on": "eyes",
     "to": "eyes"
    }
   ]
  },
  {
   "slot": "S8",
   "text": "A pope should love his own portrait.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "pope",
     "to": "pope_top"
    }
   ]
  },
  {
   "slot": "S9",
   "text": "But Innocent called it too true.",
   "kind": "FACT",
   "source": 22,
   "show": [
    {
     "on": "Innocent",
     "to": "pope_face"
    }
   ]
  },
  {
   "slot": "S10",
   "text": "And here's the disturbing part.",
   "kind": "READING",
   "source": null
  },
  {
   "slot": "S11",
   "text": "He sits still on his throne, yet his eyes are already judging you.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "throne",
     "to": "pope"
    },
    {
     "on": "eyes",
     "to": "eyes"
    }
   ]
  },
  {
   "slot": "S12",
   "text": "As if the painter caught what the pope wanted hidden.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "pope",
     "to": "pope_face"
    }
   ]
  },
  {
   "slot": "S13",
   "text": "So is the pope judging you, or afraid of what you see?",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "pope",
     "to": "eyes"
    }
