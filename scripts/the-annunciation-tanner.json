     "to": "main_action"
    }
   ]
  },
  {
   "slot": "H3",
   "text": "A girl sits on an unmade bed.",
   "kind": "LOOK",
   "source": 6,
   "show": [
    {
     "on": "bed",
     "to": "bed"
    }
   ]
  },
  {
   "slot": "H3",
   "text": "Her hands are clenched together.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "hands",
     "to": "hands"
    }
   ]
  },
  {
   "slot": "H3",
   "text": "And a pillar of light stands before her.",
   "kind": "FACT",
   "source": 6,
   "show": [
    {
     "on": "light",
     "to": "light"
    }
   ]
  },
  {
   "slot": "H4",
   "text": "Henry Ossawa Tanner painted her in 1898, in peasant clothes with no halo.",
   "kind": "FACT",
   "source": 6
  },
  {
   "slot": "H5",
   "text": "Why paint the Virgin Mary like a frightened girl?",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "girl",
     "to": "face"
    }
   ]
  },
  {
   "slot": "H6",
   "text": "The answer is in the light.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "light",
     "to": "light"
    }
   ]
  },
  {
   "slot": "H7",
   "text": "That column is the archangel Gabriel.",
   "kind": "FACT",
   "source": 6,
   "show": [
    {
     "on": "column",
     "to": "light"
    }
   ]
  },
  {
   "slot": "H7",
   "text": "He has come to tell her she will bear a son.",
   "kind": "FACT",
   "source": 5
  },
  {
   "slot": "H8",
   "text": "It isn't a blessing.",
   "kind": "READING",
   "source": null
  },
  {
   "slot": "H8",
   "text": "It's a burden.",
   "kind": "READING",
   "source": null,
   "show": [
