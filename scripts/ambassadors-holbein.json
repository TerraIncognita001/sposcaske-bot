 "sentences": [
  {
   "slot": "S1",
   "text": "There's a disturbing reason these two proud men stand so close to something hidden.",
   "kind": "HOOK",
   "source": null,
   "show": [
    {
     "on": "men",
     "to": "main_action"
    },
    {
     "on": "hidden",
     "to": "floor"
    }
   ]
  },
  {
   "slot": "S2",
   "text": "This is The Ambassadors, painted by Hans Holbein the Younger in 1533.",
   "kind": "FACT",
   "source": 1
  },
  {
   "slot": "S3",
   "text": "Two men stand beside a table full of globes, instruments, a lute and a book.",
   "kind": "LOOK",
   "source": 6,
   "show": [
    {
     "on": "men",
     "to": "main_action"
    },
    {
     "on": "table",
     "to": "table"
    },
    {
     "on": "instruments",
     "to": "instruments"
    },
    {
     "on": "lute",
     "to": "lute"
    },
    {
     "on": "book",
     "to": "book"
    }
   ]
  },
  {
   "slot": "S4",
   "text": "But look at the floor.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "floor",
     "to": "floor"
    }
   ]
  },
  {
   "slot": "S5",
   "text": "A grey shape cuts across it.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "shape",
     "to": "skull"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "The men don't see it.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "men",
     "to": "main_action"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "The men don't step around it.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "step",
     "to": "skull"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "The men simply stand.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "men",
     "to": "main_action"
    }
   ]
  },
  {
   "slot": "S7",
   "text": "According to the National Gallery, Holbein painted the shape as a skull that only appears from the side.",
   "kind": "FACT",
   "source": 31,
   "show": [
    {
     "on": "skull",
     "to": "skull"
    }
   ]
  },
  {
   "slot": "S8",
   "text": "A portrait should flatter the men who paid.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "men",
     "to": "main_action"
    }
   ]
  },
  {
   "slot": "S9",
   "text": "But Holbein put death at their feet instead.",
   "kind": "FACT",
   "source": 11,
   "show": [
    {
     "on": "death",
     "to": "skull"
    }
   ]
  },
  {
   "slot": "S10",
   "text": "And here's the disturbing part.",
   "kind": "READING",
   "source": null
  },
  {
   "slot": "S11",
   "text": "Death lies in plain sight, yet nobody standing in front notices it.",
   "kind": "READING",
   "source": 11,
   "show": [
    {
     "on": "Death",
     "to": "skull"
    },
    {
     "on": "nobody",
     "to": "main_action"
    }
   ]
  },
  {
   "slot": "S12",
   "text": "As if it waits for you to step aside.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "waits",
     "to": "skull"
    }
   ]
  },
  {
   "slot": "S13",
   "text": "So is this a portrait of power, or of the skull below?",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "power",
     "to": "main_action"
    },
    {
     "on": "skull",
