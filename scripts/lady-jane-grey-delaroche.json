    },
    {
     "on": "axe",
     "to": "axe"
    }
   ]
  },
  {
   "slot": "S4",
   "text": "But look at her hand.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "hand",
     "to": "hand"
    }
   ]
  },
  {
