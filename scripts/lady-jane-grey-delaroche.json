 "punch": "BLIND",
 "sentences": [
  {
   "slot": "S1",
   "text": "What if this young queen has to find her own death completely blind?",
   "kind": "HOOK",
   "source": null,
   "show": [
    {
     "on": "queen",
     "to": "jane_top"
    },
    {
     "on": "blind",
     "to": "blindfold"
    }
   ]
  },
  {
   "slot": "S2",
   "text": "This is The Execution of Lady Jane Grey, painted by Paul Delaroche in 1833.",
   "kind": "FACT",
   "source": 1
  },
  {
   "slot": "S3",
   "text": "Jane kneels in white on the straw, an old lieutenant at her side and the executioner waiting.",
   "kind": "LOOK",
   "source": 17,
   "show": [
    {
     "on": "Jane",
     "to": "jane"
    },
    {
     "on": "straw",
     "to": "straw"
    },
    {
     "on": "lieutenant",
     "to": "chandos"
    },
    {
     "on": "executioner",
     "to": "executioner"
    }
   ]
  },
  {
   "slot": "S4",
   "text": "But look at her hand.",
   "kind": "LOOK",
   "source": null,
   "show": [
    {
     "on": "hand",
     "to": "hand"
    }
   ]
  },
  {
   "slot": "S5",
   "text": "Her fingers reach for the block.",
   "kind": "LOOK",
   "source": 18,
   "show": [
    {
     "on": "fingers",
     "to": "hand"
    },
    {
     "on": "block",
     "to": "hand_block"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "Jane can't see the block.",
   "kind": "LOOK",
   "source": 17,
   "show": [
    {
     "on": "Jane",
     "to": "jane"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "Jane can't touch it.",
   "kind": "LOOK",
   "source": 18,
   "show": [
    {
     "on": "Jane",
     "to": "jane"
    }
   ]
  },
  {
   "slot": "S6",
   "text": "Jane just keeps searching.",
   "kind": "LOOK",
   "source": 18,
   "show": [
    {
     "on": "searching",
     "to": "hand"
    }
   ]
  },
  {
   "slot": "S7",
   "text": "According to the National Gallery, she was seventeen and had been queen for only nine days.",
   "kind": "FACT",
   "source": 12,
   "show": [
    {
     "on": "queen",
     "to": "jane_face"
    }
   ]
  },
  {
   "slot": "S8",
   "text": "A crowned girl should never kneel like this.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "girl",
     "to": "jane"
    }
   ]
  },
  {
   "slot": "S9",
   "text": "But Queen Mary had her beheaded anyway.",
   "kind": "FACT",
   "source": 12,
   "show": [
    {
     "on": "beheaded",
     "to": "executioner"
    }
   ]
  },
  {
   "slot": "S10",
   "text": "And here's the unsettling part.",
   "kind": "READING",
   "source": null
  },
  {
   "slot": "S11",
   "text": "Every eye in the room sees the block, yet Jane must search.",
   "kind": "READING",
   "source": null,
   "show": [
    {
     "on": "block",
     "to": "main_action"
    },
    {
     "on": "Jane",
