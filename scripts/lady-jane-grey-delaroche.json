  {
   "slot": "S2",
   "text": "This is The Execution of Lady Jane Grey, painted by Paul Delaroche in 1833.",
   "kind": "FACT",
   "source": 1
  },
  {
   "slot": "S3",
   "text": "Jane kneels in white before the block, while two ladies weep and the executioner waits with his axe.",
