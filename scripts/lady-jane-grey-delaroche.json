    }
   ]
  },
  {
   "slot": "S7",
   "text": "According to the National Gallery, Jane had been proclaimed queen, then deposed only nine days later.",
   "kind": "FACT",
   "source": 4,
   "show": [
    {
     "on": "Jane",
     "to": "jane_face"
    }
   ]
  },
  {
