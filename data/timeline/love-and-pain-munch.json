{
 "total": 54.745759637188215,
 "lines": [
  {
   "t0": 1.65,
   "t1": 3.38,
   "beat": "hook",
   "say": "What if this famous vampire"
  },
  {
   "t0": 3.38,
   "t1": 4.58,
   "beat": "hook",
   "say": "is really just a kiss?"
  },
  {
   "t0": 5.23,
   "t1": 6.92,
   "beat": "ident",
   "say": "This is Love and Pain,"
  },
  {
   "t0": 7.14,
   "t1": 10.17,
   "beat": "ident",
   "say": "painted by Edvard Munch in 1895."
  },
  {
   "t0": 10.77,
   "t1": 13.42,
   "beat": "usual",
   "say": "Everyone knows it by another name, Vampire."
  },
  {
   "t0": 14.02,
   "t1": 18.02,
   "beat": "usual",
   "say": "The critic Stanisław Przybyszewski saw a submissive man"
  },
  {
   "t0": 18.02,
   "t1": 20.45,
   "beat": "usual",
   "say": "with a biting vampire's face on his neck."
  },
  {
   "t0": 21.05,
   "t1": 22.79,
   "beat": "seems",
   "say": "And the picture seems to agree."
  },
  {
   "t0": 23.39,
   "t1": 25.33,
   "beat": "seems",
   "say": "Her red hair pours over him,"
  },
  {
   "t0": 25.55,
   "t1": 27.21,
   "beat": "seems",
   "say": "and her arms hold him tight."
  },
  {
   "t0": 27.81,
   "t1": 29.13,
   "beat": "turn",
   "say": "But look at her lips."
  },
  {
   "t0": 29.73,
   "t1": 31.54,
   "beat": "detail",
   "say": "There are no teeth, no blood."
  },
  {
   "t0": 32.14,
   "t1": 33.65,
   "beat": "fact",
   "say": "According to Munch himself,"
  },
  {
   "t0": 33.87,
   "t1": 35.63,
   "beat": "fact",
   "say": "it showed nothing more than"
  },
  {
   "t0": 35.63,
   "t1": 37.14,
   "beat": "fact",
   "say": "a woman kissing a man on the neck."
  },
  {
   "t0": 37.74,
   "t1": 39.96,
   "beat": "fact",
   "say": "The name Vampire came from his friend,"
  },
  {
   "t0": 40.18,
   "t1": 41.39,
   "beat": "fact",
   "say": "never from Munch."
  },
  {
   "t0": 41.99,
   "t1": 43.05,
   "beat": "fact",
   "say": "He still painted"
  },
  {
   "t0": 43.05,
   "t1": 45.13,
   "beat": "fact",
   "say": "the embrace six times in three years."
  },
  {
   "t0": 45.73,
   "t1": 47.57,
   "beat": "flip",
   "say": "It isn't a monster feeding."
  },
  {
   "t0": 48.17,
   "t1": 50.34,
   "beat": "flip",
   "say": "It's love, and the pain that comes with it."
  },
  {
   "t0": 51.14,
   "t1": 52.73,
   "beat": "question",
   "say": "So is she biting him,"
  },
  {
   "t0": 52.95,
   "t1": 54.4,
   "beat": "question",
   "say": "or holding on to him?"
  }
 ]
}