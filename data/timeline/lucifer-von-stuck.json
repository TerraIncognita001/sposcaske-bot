{
 "total": 60.296961451247164,
 "lines": [
  {
   "t0": 1.65,
   "t1": 3.45,
   "beat": "hook",
   "say": "This painting may hide something"
  },
  {
   "t0": 3.67,
   "t1": 5.47,
   "beat": "hook",
   "say": "that sits in total darkness,"
  },
  {
   "t0": 5.69,
   "t1": 6.94,
   "beat": "hook",
   "say": "completely awake."
  },
  {
   "t0": 7.59,
   "t1": 8.87,
   "beat": "ident",
   "say": "This is Lucifer,"
  },
  {
   "t0": 9.09,
   "t1": 12.02,
   "beat": "ident",
   "say": "painted by Franz Stuck in 1890."
  },
  {
   "t0": 12.62,
   "t1": 14.43,
   "beat": "setup",
   "say": "A man sits in the darkness"
  },
  {
   "t0": 14.65,
   "t1": 16.24,
   "beat": "setup",
   "say": "with his chin on his hand."
  },
  {
   "t0": 16.84,
   "t1": 18.79,
   "beat": "setup",
   "say": "A black wing hangs at his side."
  },
  {
   "t0": 19.39,
   "t1": 20.68,
   "beat": "turn",
   "say": "But look at his eyes."
  },
  {
   "t0": 21.28,
   "t1": 22.8,
   "beat": "detail",
   "say": "His eyes are glowing."
  },
  {
   "t0": 23.4,
   "t1": 24.8,
   "beat": "detail",
   "say": "They look straight at you."
  },
  {
   "t0": 25.4,
   "t1": 29.04,
   "beat": "triad",
   "say": "Lucifer doesn't blink. Lucifer doesn't look away."
  },
  {
   "t0": 29.64,
   "t1": 31.23,
   "beat": "triad",
   "say": "Lucifer simply waits."
  },
  {
   "t0": 31.83,
   "t1": 34.6,
   "beat": "backstory",
   "say": "According to the National Art Gallery in Sofia,"
  },
  {
   "t0": 34.82,
   "t1": 36.83,
   "beat": "backstory",
   "say": "Ferdinand of Bulgaria bought"
  },
  {
   "t0": 37.05,
   "t1": 39.46,
   "beat": "backstory",
   "say": "this painting straight from the artist's studio."
  },
  {
   "t0": 40.06,
   "t1": 42.28,
   "beat": "backstory",
   "say": "A king should hang saints in his palace."
  },
  {
   "t0": 42.88,
   "t1": 45.47,
   "beat": "backstory",
   "say": "But he chose a demon for the royal collection."
  },
  {
   "t0": 46.47,
   "t1": 48.47,
   "beat": "reveal",
   "say": "And here's the unsettling part."
  },
  {
   "t0": 49.07,
   "t1": 50.56,
   "beat": "reveal",
   "say": "His body is resting,"
  },
  {
   "t0": 50.78,
   "t1": 53.09,
   "beat": "reveal",
   "say": "yet his eyes have never been more awake."
  },
  {
   "t0": 53.69,
   "t1": 54.97,
   "beat": "reveal",
   "say": "As if he were waiting"
  },
  {
   "t0": 55.19,
   "t1": 56.62,
   "beat": "reveal",
   "say": "for you to notice him."
  },
  {
   "t0": 57.42,
   "t1": 59.95,
   "beat": "question",
   "say": "So what is Lucifer waiting for in the dark?"
  }
 ]
}