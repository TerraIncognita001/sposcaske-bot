{
 "total": 56.633650793650794,
 "lines": [
  {
   "t0": 1.65,
   "t1": 3.73,
   "beat": "hook",
   "say": "This lonely man is not praying,"
  },
  {
   "t0": 3.95,
   "t1": 5.43,
   "beat": "hook",
   "say": "he is getting ready to fight."
  },
  {
   "t0": 6.08,
   "t1": 8.0,
   "beat": "loop",
   "say": "Everyone sees a tired man,"
  },
  {
   "t0": 8.22,
   "t1": 9.65,
   "beat": "loop",
   "say": "broken by the desert."
  },
  {
   "t0": 10.25,
   "t1": 12.51,
   "beat": "tour",
   "say": "His bare feet rest on cold stone."
  },
  {
   "t0": 13.11,
   "t1": 14.98,
   "beat": "tour",
   "say": "The dawn is grey behind him."
  },
  {
   "t0": 15.58,
   "t1": 17.45,
   "beat": "tour",
   "say": "And his hands are locked together."
  },
  {
   "t0": 18.05,
   "t1": 21.29,
   "beat": "who",
   "say": "Ivan Kramskoi painted him in 1872,"
  },
  {
   "t0": 21.51,
   "t1": 23.41,
   "beat": "who",
   "say": "at the hour of his temptation."
  },
  {
   "t0": 24.01,
   "t1": 25.77,
   "beat": "stakes",
   "say": "Pavel Tretyakov bought it"
  },
  {
   "t0": 25.77,
   "t1": 27.7,
   "beat": "stakes",
   "say": "that same year for six thousand rubles."
  },
  {
   "t0": 28.3,
   "t1": 30.07,
   "beat": "stakes",
   "say": "Why would a collector pay"
  },
  {
   "t0": 30.07,
   "t1": 31.32,
   "beat": "stakes",
   "say": "so much for a defeated man?"
  },
  {
   "t0": 32.32,
   "t1": 34.14,
   "beat": "rehook",
   "say": "The answer is in those hands."
  },
  {
   "t0": 34.74,
   "t1": 37.2,
   "beat": "fact",
   "say": "The writer Vsevolod Garshin saw"
  },
  {
   "t0": 37.2,
   "t1": 39.0,
   "beat": "fact",
   "say": "complete resolve to fight evil."
  },
  {
   "t0": 39.6,
   "t1": 40.74,
   "beat": "fact",
   "say": "Ivan Goncharov wrote"
  },
  {
   "t0": 40.74,
   "t1": 44.0,
   "beat": "fact",
   "say": "that nothing here was heroic or victorious."
  },
  {
   "t0": 44.6,
   "t1": 46.16,
   "beat": "fact",
   "say": "Yet the whole fate of the world"
  },
  {
   "t0": 46.16,
   "t1": 48.05,
   "beat": "fact",
   "say": "was hidden in this small figure."
  },
  {
   "t0": 48.65,
   "t1": 49.93,
   "beat": "flip",
   "say": "He isn't broken."
  },
  {
   "t0": 50.53,
   "t1": 51.74,
   "beat": "flip",
   "say": "He's deciding."
  },
  {
   "t0": 52.54,
   "t1": 54.0,
   "beat": "question",
   "say": "So is he giving up,"
  },
  {
   "t0": 54.22,
   "t1": 56.28,
   "beat": "question",
   "say": "or gathering the strength to stand?"
  }
 ]
