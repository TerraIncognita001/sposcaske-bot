{
 "total": 57.25990929705217,
 "lines": [
  {
   "t0": 1.65,
   "t1": 3.35,
   "beat": "hook",
   "say": "There's a disturbing detail"
  },
  {
   "t0": 3.57,
   "t1": 6.12,
   "beat": "hook",
   "say": "in this diplomatic room most people miss."
  },
  {
   "t0": 6.77,
   "t1": 8.38,
   "beat": "ident",
   "say": "This is The Ambassadors,"
  },
  {
   "t0": 8.6,
   "t1": 12.24,
   "beat": "ident",
   "say": "painted by Hans Holbein the Younger in 1533."
  },
  {
   "t0": 12.84,
   "t1": 15.09,
   "beat": "setup",
   "say": "Two rich ambassadors stand beside"
  },
  {
   "t0": 15.31,
   "t1": 17.15,
   "beat": "setup",
   "say": "a table stacked with instruments,"
  },
  {
   "t0": 17.37,
   "t1": 18.9,
   "beat": "setup",
   "say": "showing off their knowledge."
  },
  {
   "t0": 19.5,
   "t1": 20.64,
   "beat": "turn",
   "say": "But look closer."
  },
  {
   "t0": 21.24,
   "t1": 23.95,
   "beat": "detail",
   "say": "A strange grey shape floats across the floor."
  },
  {
   "t0": 24.55,
   "t1": 27.15,
   "beat": "triad",
   "say": "It doesn't fit. It doesn't belong."
  },
  {
   "t0": 27.75,
   "t1": 29.02,
   "beat": "triad",
   "say": "It simply floats."
  },
  {
   "t0": 29.62,
   "t1": 31.71,
   "beat": "backstory",
   "say": "According to the National Gallery,"
  },
  {
   "t0": 31.93,
   "t1": 35.56,
   "beat": "backstory",
   "say": "Holbein painted a human skull skewed in extreme perspective."
  },
  {
   "t0": 36.16,
   "t1": 38.77,
   "beat": "backstory",
   "say": "Viewers should see a normal diplomatic meeting."
  },
  {
   "t0": 39.37,
   "t1": 41.95,
   "beat": "backstory",
   "say": "But a sinister shadow of death corrupts the room."
  },
  {
   "t0": 42.95,
   "t1": 44.7,
   "beat": "reveal",
   "say": "And here's the disturbing part."
  },
  {
   "t0": 45.3,
   "t1": 46.93,
   "beat": "reveal",
   "say": "They display worldly wealth,"
  },
  {
   "t0": 47.15,
   "t1": 48.71,
   "beat": "reveal",
   "say": "yet death haunts their feet."
  },
  {
   "t0": 49.31,
   "t1": 52.1,
   "beat": "reveal",
   "say": "Almost as if all their knowledge cannot save them."
  },
  {
   "t0": 52.9,
   "t1": 54.96,
   "beat": "question",
   "say": "So do you see a showcase of power,"
  },
  {
   "t0": 55.18,
   "t1": 56.91,
   "beat": "question",
   "say": "or the skull waiting below?"
  }
 ]
}