  "hook_title": "CALM",
  "lines": [
    {"beat": "hook", "say": "This man is about to be eaten alive,", "cam": [{"to": "daniel_top", "how": "cut"}, {"to": "faces", "how": "cut", "on": "eaten"}]},
    {"beat": "hook", "say": "and somehow he is completely calm.", "cam": [{"to": "daniel_top", "how": "cut", "on": "he"}, {"to": "daniel_lions", "on": "completely"}]},
    {"beat": "ident", "say": "This is Daniel in the Lions' Den,", "cam": [{"to": "full", "how": "cut", "at": 0.14}, {"to": "card", "at": 0.5}]},
    {"beat": "ident", "say": "painted by Briton Rivière in 1872.", "cam": {"image": "portrait", "on": "Briton"}},
    {"beat": "setup", "say": "Daniel stands in a stone pit,", "cam": {"to": "full", "how": "cut", "push": true}},
    {"beat": "setup", "say": "surrounded by lions,", "cam": {"to": "faces", "on": "surrounded"}},
    {"beat": "setup", "say": "with old bones scattered across the floor.", "cam": {"to": "bones", "on": "bones"}},
    {"beat": "turn", "say": "But look at his hands.", "cam": {"to": "hands", "on": "his"}, "accent": true},
    {"beat": "detail", "say": "They're tied behind his back."},
    {"beat": "triad", "say": "He can't fight. He can't run.", "cam": {"to": "daniel_top"}},
    {"beat": "triad", "say": "He can only stand there.", "cam": {"to": "daniel"}},
    {"beat": "backstory", "say": "According to the Book of Daniel,", "cam": {"to": "full", "how": "cut", "push": true}},
    {"beat": "backstory", "say": "he was sentenced to this pit"},
    {"beat": "backstory", "say": "because he would not stop praying."},
    {"beat": "backstory", "say": "Nobody survives a night in a lions' den.", "cam": {"to": "pack", "on": "night"}},
    {"beat": "backstory", "say": "But at sunrise, the king found him alive.", "cam": {"to": "daniel_top", "on": "sunrise"}},
    {"beat": "reveal", "say": "And here's the unsettling part.", "cam": {"to": "full", "how": "cut", "push": true}, "accent": true, "pause_before": 0.4},
    {"beat": "reveal", "say": "The lions are snarling,", "cam": {"to": "faces", "how": "cut"}},
    {"beat": "reveal", "say": "yet Daniel hasn't moved a step.", "cam": {"to": "daniel_top", "how": "cut", "on": "Daniel"}},
    {"beat": "reveal", "say": "As if he already knows how this night ends."},
    {"beat": "question", "say": "So is he waiting to die,", "cam": {"to": "daniel_lions"}, "pause_before": 0.2},
    {"beat": "question", "say": "or does he know something the lions don't?"}
