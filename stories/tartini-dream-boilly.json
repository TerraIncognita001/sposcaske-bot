 "hook_title": "DEVIL",
 "lines": [
  {
   "beat": "hook",
   "say": "What if the most beautiful music",
   "cam": {
    "to": "violin",
    "how": "cut"
   }
  },
  {
   "beat": "hook",
   "say": "a man ever heard",
   "cam": {
    "to": "sleeper_face",
    "how": "cut",
    "on": "man"
   }
  },
  {
   "beat": "hook",
   "say": "was played by the devil?",
   "cam": [
    {
     "to": "devil_head",
     "how": "cut",
     "on": "played"
    },
    {
     "to": "reach",
     "on": "the"
    }
   ]
  },
  {
   "beat": "ident",
   "say": "This is Tartini's Dream,",
   "cam": [
    {
     "to": "full",
     "how": "cut",
     "at": 0.14
    },
    {
     "to": "card",
     "at": 0.5
    }
   ]
  },
  {
   "beat": "ident",
   "say": "drawn by Louis-Léopold Boilly in 1824.",
   "cam": {
    "image": "portrait",
    "on": "Louis"
   }
  },
  {
   "beat": "setup",
   "say": "A violinist lies asleep in his bed,",
   "cam": {
    "to": "sleeper",
    "how": "cut"
   }
  },
  {
   "beat": "setup",
   "say": "and at his feet sits the devil,",
   "cam": {
    "to": "devil",
    "on": "feet"
   }
  },
  {
   "beat": "setup",
   "say": "playing a violin.",
   "cam": {
    "to": "devil_play",
    "on": "playing"
   }
  },
  {
   "beat": "turn",
   "say": "But look at the sleeper's hands.",
   "cam": {
    "to": "hands",
    "on": "the"
   },
   "accent": true
  },
  {
   "beat": "detail",
   "say": "They are open, and reaching out."
  },
  {
   "beat": "triad",
   "say": "He doesn't scream. He doesn't hide.",
   "cam": {
    "to": "sleeper_face"
   }
  },
  {
   "beat": "triad",
   "say": "He simply listens.",
   "cam": {
    "to": "sleeper_top"
   }
  },
  {
   "beat": "backstory",
   "say": "According to Tartini's own account,",
   "cam": {
    "scene": "tartini",
    "to": "face",
    "on": "Tartini"
   }
  },
  {
   "beat": "backstory",
   "say": "written down by the astronomer Jérôme Lalande,",
   "cam": {
    "scene": "lalande",
    "on": "astronomer"
   }
  },
  {
   "beat": "backstory",
   "say": "he dreamed the devil became his servant.",
   "cam": {
    "scene": "main",
    "to": "devil",
    "on": "dreamed"
   }
  },
  {
   "beat": "backstory",
   "say": "He handed the devil his violin,",
   "cam": {
    "to": "reach",
    "on": "handed"
   }
  },
  {
   "beat": "backstory",
   "say": "and the devil played a sonata so beautiful",
   "cam": {
    "to": "devil_play",
    "on": "played"
   }
  },
  {
   "beat": "backstory",
   "say": "that Tartini woke up breathless.",
   "cam": {
    "to": "sleeper_face",
    "how": "cut",
    "on": "Tartini"
   }
  },
  {
   "beat": "backstory",
   "say": "He should have remembered every note.",
   "cam": {
    "to": "table",
    "on": "remembered"
   }
  },
  {
   "beat": "backstory",
   "say": "But when he grabbed his violin,",
   "cam": {
    "scene": "tartini",
    "to": "violin",
    "on": "grabbed"
   }
  },
  {
   "beat": "backstory",
   "say": "the music was gone."
  },
  {
   "beat": "backstory",
   "say": "What he managed to write",
   "cam": {
    "scene": "sheet",
    "pan": [
     "left",
     "right"
    ]
   }
  },
  {
   "beat": "backstory",
   "say": "became the Devil's Trill Sonata.",
   "cam": {
    "to": "title",
    "on": "the"
   }
  },
  {
   "beat": "reveal",
   "say": "And here's the disturbing part.",
   "cam": {
    "scene": "main",
    "to": "full",
    "push": true
   },
   "accent": true,
   "pause_before": 0.4
  },
  {
   "beat": "reveal",
   "say": "It is his most famous work,"
  },
  {
   "beat": "reveal",
   "say": "yet Tartini said it fell far short.",
   "cam": {
    "to": "sleeper_face",
    "how": "cut",
    "on": "Tartini"
   }
  },
  {
   "beat": "reveal",
   "say": "He said he would have broken his violin.",
   "cam": [
    {
     "scene": "tartini",
     "to": "face"
    },
    {
     "to": "violin",
     "on": "broken"
    }
   ]
  },
  {
   "beat": "reveal",
   "say": "He would have given up music forever,"
  },
  {
   "beat": "reveal",
   "say": "if he could have lived without it."
  },
  {
   "beat": "reveal",
   "say": "As if every note afterwards",
   "cam": {
    "scene": "sheet",
    "to": "left",
    "on": "every"
   }
  },
  {
   "beat": "reveal",
   "say": "only reminded him of that night.",
   "cam": {
    "scene": "main",
    "to": "sleeper_top",
    "on": "reminded"
   }
  },
  {
   "beat": "reveal",
   "say": "Maybe it was only a dream.",
   "cam": {
    "scene": "marshall"
   }
  },
  {
   "beat": "reveal",
   "say": "Maybe it was the best concert"
  },
  {
   "beat": "reveal",
   "say": "nobody else will ever hear."
  },
  {
   "beat": "reveal",
   "say": "So look at his hands one more time.",
   "cam": {
    "scene": "main",
    "to": "hands",
    "on": "look"
   }
  },
  {
   "beat": "question",
   "say": "So is he begging the devil to stop,",
   "cam": {
    "to": "reach",
    "on": "begging"
   },
   "pause_before": 0.2
  },
  {
   "beat": "question",
   "say": "or begging him to play on?"
  }
